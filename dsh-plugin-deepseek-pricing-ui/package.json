{
  "name": "dsh-plugin-deepseek-pricing-ui",
  "version": "0.1.0",
  "description": "DeepSeek 定价面板：Web 侧边栏实时定价与费用预估界面包（依赖 dsh-plugin-deepseek-pricing 的解析逻辑）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "pricing",
    "ui",
    "定价"
  ],
  "license": "MIT",
  "dependencies": {
    "dsh-plugin-deepseek-pricing": "file:../dsh-plugin-deepseek-pricing"
  }
}
